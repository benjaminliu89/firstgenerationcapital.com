---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper-2">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 text-[13px] text-ink-soft sm:px-8 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-3 text-ink">
      <img src="/brand/tree.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span class="wordmark text-[18px]"><b>First Generation</b> Capital<span class="text-brand">.</span></span>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-ink">LinkedIn</a>
      <a href="/terms/" class="hover:text-ink">Terms of Use</a>
      <a href="/privacy/" class="hover:text-ink">Privacy Policy</a>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-[12px] text-ink-soft sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <span>Investments shown are for information only and do not constitute an offer or solicitation.</span>
    </div>
  </div>
</footer>
