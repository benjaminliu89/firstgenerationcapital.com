---
import { site } from "../data/site";
const isHome = Astro.url.pathname === "/";
const link = (hash: string) => (isHome ? hash : `/${hash}`);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
      <img src="/brand/emblem.png" alt="" width="34" height="34" class="h-[34px] w-[34px]" />
      <span class="hidden text-[13px] font-medium uppercase leading-none tracking-[0.18em] sm:block">
        First Generation<br />Capital
      </span>
    </a>
    <nav class="flex items-center gap-6 text-[12px] uppercase tracking-[0.18em]">
      <a href={link("#about")} class="hidden text-ink-soft transition-colors hover:text-ink sm:block">About</a>
      <a href={link("#portfolio")} class="text-ink-soft transition-colors hover:text-ink">Portfolio</a>
      <a
        href={site.contactUrl}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-ink px-5 py-2.5 text-paper transition-colors hover:bg-brand"
      >
        Contact
      </a>
    </nav>
  </div>
</header>
