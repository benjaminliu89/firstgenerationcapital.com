---
import portfolio from "../data/portfolio.json";
import { categories, type PortfolioItem } from "../data/site";

const items = (portfolio as PortfolioItem[])
  .slice()
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || a.name.localeCompare(b.name));
const groups = categories
  .filter((c) => c.id !== "all")
  .map((c) => ({ ...c, items: items.filter((i) => i.category === c.id) }))
  .filter((g) => g.items.length);
const years = items.map((i) => i.year).filter((y): y is number => y != null);
const span = `${Math.min(...years)} to ${Math.max(...years)}`;
---

<section id="portfolio" class="scroll-mt-16 border-t border-line bg-paper">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Portfolio · {span}</p>
        <h2 class="mt-3 font-display text-4xl font-light leading-[1.05] sm:text-5xl">
          Where our capital is.
        </h2>
      </div>
      <p class="max-w-sm text-[15px] leading-relaxed text-ink-soft">
        {items.length} investments since 2018: fund commitments and direct positions, grouped by strategy.
      </p>
    </div>

    <div class="mt-16 space-y-14">
      {groups.map((g) => (
        <div id={`portfolio-${g.id}`} class="reveal grid gap-6 border-t border-line pt-8 md:grid-cols-[220px_1fr]">
          <div>
            <h3 class="font-display text-2xl font-light">{g.label}</h3>
          </div>
          <ul class="grid gap-x-10 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((i) => (
              <li class="flex items-baseline justify-between gap-3 border-b border-line/70 pb-3 text-[15px]">
                {i.url ? (
                  <a href={i.url} target="_blank" rel="noopener" class="transition-colors hover:text-brand">{i.name}</a>
                ) : (
                  <span>{i.name}</span>
                )}
                <span class="shrink-0 text-[12px] tabular-nums text-ink-soft">
                  {i.status === "Exited" ? "Exited · " : ""}{i.year ?? ""}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
