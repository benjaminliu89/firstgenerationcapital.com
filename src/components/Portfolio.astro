---
import portfolio from "../data/portfolio.json";
import { categories, type PortfolioItem } from "../data/site";

const items = (portfolio as PortfolioItem[])
  .slice()
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || a.name.localeCompare(b.name));
const counts = Object.fromEntries(categories.map((c) => [c.id, c.id === "all" ? items.length : items.filter((i) => i.category === c.id).length]));
const years = items.map((i) => i.year).filter((y): y is number => y != null);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---

<section id="portfolio" class="scroll-mt-16 bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow !text-paper/50">Portfolio · {span}</p>
        <h2 class="mt-3 font-display text-4xl font-light leading-[1.05] sm:text-5xl">
          Where our capital is.
        </h2>
      </div>
      <p class="max-w-sm text-[15px] leading-relaxed text-paper/60">
        {items.length} investments since 2018: fund commitments and direct positions, listed by year.
      </p>
    </div>

    <div
      class="reveal mt-14 flex gap-7 overflow-x-auto border-b border-paper/15 [scrollbar-width:none]"
      role="group"
      aria-label="Filter portfolio by strategy"
    >
      {categories.map((c) => (
        <button
          type="button"
          class="filter-btn !text-paper/55 shrink-0 hover:!text-paper aria-pressed:!text-paper"
          data-filter={c.id}
          aria-pressed={c.id === "all" ? "true" : "false"}
        >
          {c.label} <span class="ml-1 text-paper/35">{counts[c.id]}</span>
        </button>
      ))}
    </div>

    <ul id="portfolio-grid" class="mt-10 grid grid-cols-2 border-l border-t border-paper/10 sm:grid-cols-3 lg:grid-cols-4">
      {items.map((item) => {
        const Tag = item.url ? "a" : "div";
        return (
          <li class="portfolio-item border-b border-r border-paper/10" data-category={item.category} data-year={item.year ?? undefined}>
            <Tag
              href={item.url || undefined}
              target={item.url ? "_blank" : undefined}
              rel={item.url ? "noopener" : undefined}
              class="group flex h-full flex-col justify-between gap-8 p-5 transition-colors hover:bg-paper/[0.04] sm:p-7"
            >
              <div class="flex h-14 items-center">
                <img
                  src={item.logo}
                  alt={`${item.name} logo`}
                  loading="lazy"
                  decoding="async"
                  class="max-h-11 w-auto max-w-[75%] object-contain object-left opacity-75 transition group-hover:opacity-100"
                />
              </div>
              <div class="flex items-end justify-between gap-3">
                <div>
                  <p class="text-[15px] font-medium leading-tight">{item.name}</p>
                  <p class="mt-1 text-[12px] uppercase tracking-[0.14em] text-paper/45">
                    {item.status === "Exited" ? "Exited" : "Invested"}{item.year ? ` ${item.year}` : ""}
                  </p>
                </div>
                {item.url && (
                  <span class="text-paper/40 transition group-hover:text-brand" aria-hidden="true">↗</span>
                )}
              </div>
            </Tag>
          </li>
        );
      })}
    </ul>
    <p id="portfolio-empty" class="mt-10 hidden text-paper/60">No investments in this category yet.</p>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLLIElement>(".portfolio-item");
  const empty = document.getElementById("portfolio-empty")!;

  function apply(filter: string) {
    let shown = 0;
    items.forEach((li) => {
      const show = filter === "all" || li.dataset.category === filter;
      li.hidden = !show;
      if (show) {
        shown++;
        li.style.animation = "none";
        void li.offsetWidth;
        li.style.animation = "";
      }
    });
    empty.classList.toggle("hidden", shown > 0);
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === filter)));
    history.replaceState(null, "", filter === "all" ? "#portfolio" : `#portfolio-${filter}`);
  }

  buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.filter!)));

  const m = location.hash.match(/^#portfolio-(.+)$/);
  if (m && [...buttons].some((b) => b.dataset.filter === m[1])) apply(m[1]);
</script>
