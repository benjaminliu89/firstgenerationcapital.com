---
import Base from "./Base.astro";
interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---

<Base title={title}>
  <article class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-28">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-3 font-display text-4xl font-light sm:text-5xl">{title}</h1>
    <p class="mt-4 text-[13px] text-ink-soft">Last updated {updated}</p>
    <div class="prose-fgc mt-12 space-y-6 text-[16px] leading-relaxed text-ink-soft [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-medium [&_h2]:text-ink">
      <slot />
    </div>
  </article>
</Base>
