---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="mx-auto max-w-6xl px-5 py-32 sm:px-8">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-display text-4xl font-light sm:text-5xl">This page doesn't exist.</h1>
    <a href="/" class="mt-8 inline-block text-[12px] uppercase tracking-[0.18em] underline underline-offset-4">Back to home</a>
  </section>
</Base>
