---
import Base from "../layouts/Base.astro";
import Portfolio from "../components/Portfolio.astro";
---

<Base>
  <section id="about" class="relative overflow-hidden">
    <div class="hero-inner mx-auto max-w-6xl px-5 pb-24 pt-16 sm:px-8 sm:pb-28 sm:pt-24">
      <img src="/brand/tree.svg" alt="" width="160" height="160" class="hero-mark" />
      <h1 class="max-w-4xl font-display font-light leading-[1.02] tracking-[-0.01em]">
        <span class="font-medium">First Generation</span> <br />Capital
      </h1>
      <div class="hero-sub max-w-2xl text-[17px] leading-relaxed text-ink-soft">
        <p>
          First Generation Capital is a single family office that has invested its own capital since 2018, directly in
          early-stage companies and with venture, private equity, real estate and hedge fund managers.
        </p>
      </div>
    </div>
  </section>

  <Portfolio />
</Base>
