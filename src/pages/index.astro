---
import Base from "../layouts/Base.astro";
import Portfolio from "../components/Portfolio.astro";
import { site } from "../data/site";

const pillars = [
  {
    title: "Startups",
    body: "Small direct cheques into early-stage companies, usually alongside a lead investor we know.",
  },
  {
    title: "Private Equity",
    body: "Fund commitments and co-investments across buyout, growth and secondaries.",
  },
  {
    title: "Venture Capital Funds",
    body: "Limited partner commitments to seed and early-stage venture funds, including first-time managers.",
  },
  {
    title: "Real Estate",
    body: "Residential and commercial property, through specialist funds and a small number of direct positions.",
  },
  {
    title: "Hedge Funds",
    body: "A small allocation to liquid strategies alongside the private portfolio.",
  },
];
---

<Base>
  <section id="hero" class="relative overflow-hidden">
    <div class="hero-inner mx-auto max-w-6xl px-5 pb-24 pt-24 sm:px-8 sm:pb-32 sm:pt-36">
      <img src="/brand/tree.svg" alt="" width="160" height="160" class="hero-mark brand-mark" />
      <p class="eyebrow reveal">Single family office · Est. 2018</p>
      <h1 class="reveal mt-6 max-w-4xl font-display text-[clamp(2.75rem,7vw,5.5rem)] font-light leading-[1.02] tracking-[-0.01em]">
        First Generation<br /><span class="font-medium">Capital</span><span class="text-brand">.</span>
      </h1>
      <div class="hero-sub reveal mt-12 flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-xl text-lg leading-relaxed text-ink-soft">
          A single family office investing its own capital since 2018, in early-stage companies and with venture,
          private equity, real estate and hedge fund managers. We do not raise outside money.
        </p>
        <a
          href="#portfolio"
          class="group inline-flex items-center gap-3 text-[12px] uppercase tracking-[0.18em]"
        >
          View portfolio
          <span class="grid h-9 w-9 place-items-center rounded-full border border-ink transition group-hover:bg-ink group-hover:text-paper">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section id="about" class="scroll-mt-16 border-t border-line">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-24 sm:px-8 sm:py-32 md:grid-cols-[1fr_1.6fr]">
      <div class="reveal">
        <p class="eyebrow">About</p>
        <h2 class="mt-3 font-display text-3xl font-light leading-tight sm:text-4xl">Who we are</h2>
      </div>
      <div class="reveal space-y-6 text-[17px] leading-relaxed text-ink-soft">
        <p>
          First Generation Capital is a permanent capital vehicle. We invest only our own capital, with no outside
          investors and no fund cycle, so we can hold investments for as long as they make sense.
        </p>
        <p>
          We are a small team with a modest portfolio. Most of it is commitments to fund managers we have come to
          know over time; the rest is direct investments in early-stage companies, usually alongside people we
          already work with.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-2">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="eyebrow reveal">What we invest in</p>
      <ul class="mt-10 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-5">
        {pillars.map((p, i) => (
          <li class="reveal bg-paper-2 p-7" style={`transition-delay:${i * 60}ms`}>
            <p class="font-display text-2xl font-light text-brand">0{i + 1}</p>
            <h3 class="mt-6 text-[15px] font-medium">{p.title}</h3>
            <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Portfolio />

</Base>
