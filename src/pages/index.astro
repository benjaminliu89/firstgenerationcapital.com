---
import Base from "../layouts/Base.astro";
import Portfolio from "../components/Portfolio.astro";
import { site } from "../data/site";

const pillars = [
  {
    title: "Startups",
    body: "Small direct cheques into early-stage companies, usually alongside a lead investor we know.",
  },
  {
    title: "Private Equity",
    body: "Limited partner commitments to buyout, growth and secondaries funds.",
  },
  {
    title: "Venture Capital Funds",
    body: "Limited partner commitments to seed and early-stage venture funds, including first-time managers.",
  },
  {
    title: "Real Estate",
    body: "Commitments to residential and commercial real estate funds run by specialist operators.",
  },
  {
    title: "Hedge Funds",
    body: "A small number of liquid strategies that sit alongside the private portfolio.",
  },
];
---

<Base>
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-5 pb-24 pt-24 sm:px-8 sm:pb-32 sm:pt-36">
      <p class="eyebrow reveal">First Generation Capital · Single family office</p>
      <h1 class="reveal mt-6 max-w-4xl font-display text-[clamp(2.75rem,7vw,5.5rem)] font-light leading-[1.02] tracking-[-0.01em]">
        A family office<br />investing for the <span class="text-brand">long term.</span>
      </h1>
      <div class="reveal mt-12 flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-xl text-lg leading-relaxed text-ink-soft">
          Since 2018 we have backed early-stage companies and committed to venture, private equity, real estate and
          hedge fund managers. We invest our own capital, and we keep things simple.
        </p>
        <a
          href="#portfolio"
          class="group inline-flex items-center gap-3 text-[12px] uppercase tracking-[0.18em]"
        >
          View portfolio
          <span class="grid h-9 w-9 place-items-center rounded-full border border-ink transition group-hover:bg-ink group-hover:text-paper">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section id="about" class="scroll-mt-16 border-t border-line">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-24 sm:px-8 sm:py-32 md:grid-cols-[1fr_1.6fr]">
      <div class="reveal">
        <p class="eyebrow">About</p>
        <h2 class="mt-3 font-display text-3xl font-light leading-tight sm:text-4xl">Who we are</h2>
      </div>
      <div class="reveal space-y-6 text-[17px] leading-relaxed text-ink-soft">
        <p>
          First Generation Capital is a single family office. We manage one family's capital, with no outside
          investors and no fund to raise, so we can hold investments for as long as they make sense.
        </p>
        <p>
          We are a small team and a small allocator. Most of our portfolio is commitments to fund managers we have
          gotten to know over time; the rest is direct investments in early-stage companies, usually alongside
          people we already work with.
        </p>
        <p>
          The name is a reminder. Most family wealth doesn't survive three generations. We would rather keep
          investing the way a first generation does: patient, curious, and willing to back people who are still
          early.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-2">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="eyebrow reveal">What we invest in</p>
      <ul class="mt-10 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-5">
        {pillars.map((p, i) => (
          <li class="reveal bg-paper-2 p-7" style={`transition-delay:${i * 60}ms`}>
            <p class="font-display text-2xl font-light text-brand">0{i + 1}</p>
            <h3 class="mt-6 text-[15px] font-medium">{p.title}</h3>
            <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Portfolio />

  <section class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-24 sm:px-8 sm:py-32 md:flex-row md:items-center md:justify-between">
      <h2 class="reveal max-w-xl font-display text-3xl font-light leading-tight sm:text-4xl">
        Raising a fund or a round and think we might be a fit? Get in touch.
      </h2>
      <a
        href={site.contactUrl}
        target="_blank"
        rel="noopener"
        class="reveal inline-flex shrink-0 items-center gap-3 rounded-full bg-ink px-7 py-4 text-[12px] uppercase tracking-[0.18em] text-paper transition-colors hover:bg-brand"
      >
        Contact us ↗
      </a>
    </div>
  </section>
</Base>
