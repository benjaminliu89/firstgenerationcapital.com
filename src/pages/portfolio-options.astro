---
// Review-only page: three alternative portfolio presentations. Not linked from the site.
import Base from "../layouts/Base.astro";
import portfolio from "../data/portfolio.json";
import { categories, type PortfolioItem } from "../data/site";

const items = (portfolio as PortfolioItem[])
  .slice()
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || a.name.localeCompare(b.name));
const groups = categories
  .filter((c) => c.id !== "all")
  .map((c) => ({ ...c, items: items.filter((i) => i.category === c.id) }))
  .filter((g) => g.items.length);
const label = (c: string) => categories.find((x) => x.id === c)?.label ?? c;
const when = (i: PortfolioItem) => (i.year ? String(i.year) : "—");
---

<Base title="Portfolio options (review)" description="Review page">
  <!-- Option 1: typographic index, grouped by strategy -->
  <section class="border-b border-line bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="eyebrow">Option 1 · Index by strategy</p>
      <h2 class="mt-3 font-display text-4xl font-light leading-[1.05] sm:text-5xl">Where our capital is.</h2>
      <p class="mt-4 max-w-md text-[15px] leading-relaxed text-ink-soft">
        {items.length} investments since 2018, grouped by strategy. Names, not logos.
      </p>
      <div class="mt-16 space-y-14">
        {groups.map((g) => (
          <div class="grid gap-6 border-t border-line pt-8 md:grid-cols-[220px_1fr]">
            <div>
              <h3 class="font-display text-2xl font-light">{g.label}</h3>
              <p class="mt-1 text-[13px] text-ink-soft">{g.items.length}</p>
            </div>
            <ul class="grid gap-x-10 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
              {g.items.map((i) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-line/70 pb-3 text-[15px]">
                  {i.url ? (
                    <a href={i.url} target="_blank" rel="noopener" class="hover:text-brand">{i.name}</a>
                  ) : (
                    <span>{i.name}</span>
                  )}
                  <span class="font-mono text-[12px] tabular-nums text-ink-soft">{when(i)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Option 2: ledger table, chronological -->
  <section class="border-b border-line bg-white text-ink">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="eyebrow">Option 2 · Ledger</p>
      <h2 class="mt-3 font-display text-4xl font-light leading-[1.05] sm:text-5xl">Where our capital is.</h2>
      <p class="mt-4 max-w-md text-[15px] leading-relaxed text-ink-soft">
        One row per investment, newest first. Filters stay; small mark for recognition.
      </p>
      <div class="mt-14 flex gap-7 border-b border-line">
        {categories.map((c) => (
          <span class:list={["filter-btn", c.id === "all" ? "text-ink" : "text-ink-soft"]}>{c.label}</span>
        ))}
      </div>
      <table class="mt-2 w-full text-[15px]">
        <thead>
          <tr class="text-left text-[11px] uppercase tracking-[0.16em] text-ink-soft">
            <th class="w-16 py-4 font-medium"></th>
            <th class="py-4 font-medium">Company / Fund</th>
            <th class="hidden py-4 font-medium sm:table-cell">Strategy</th>
            <th class="py-4 text-right font-medium">Year</th>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody>
          {items.map((i) => (
            <tr class="border-t border-line transition-colors hover:bg-paper">
              <td class="py-3.5 pr-4">
                <span class="flex h-9 w-9 items-center justify-center rounded-sm bg-ink">
                  <img src={i.logo} alt="" loading="lazy" class="max-h-6 max-w-6 object-contain opacity-90" />
                </span>
              </td>
              <td class="py-3.5 font-medium">
                {i.url ? <a href={i.url} target="_blank" rel="noopener" class="hover:text-brand">{i.name}</a> : i.name}
                {i.status === "Exited" && <span class="ml-2 text-[11px] uppercase tracking-[0.14em] text-ink-soft">Exited</span>}
              </td>
              <td class="hidden py-3.5 text-ink-soft sm:table-cell">{label(i.category)}</td>
              <td class="py-3.5 text-right font-mono text-[13px] tabular-nums text-ink-soft">{when(i)}</td>
              <td class="py-3.5 text-right text-ink-soft">{i.url && <span aria-hidden="true">↗</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Option 3: quiet logo wall, uniform tiles on dark, grouped -->
  <section class="bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="eyebrow !text-paper/50">Option 3 · Quiet logo wall</p>
      <h2 class="mt-3 font-display text-4xl font-light leading-[1.05] sm:text-5xl">Where our capital is.</h2>
      <p class="mt-4 max-w-md text-[15px] leading-relaxed text-paper/60">
        Logos kept but tamed: smaller, uniform, monochrome, grouped by strategy, no borders.
      </p>
      <div class="mt-16 space-y-16">
        {groups.map((g) => (
          <div>
            <div class="flex items-baseline gap-3 border-b border-paper/15 pb-3">
              <h3 class="font-display text-2xl font-light">{g.label}</h3>
              <span class="text-[13px] text-paper/45">{g.items.length}</span>
            </div>
            <ul class="mt-8 grid grid-cols-3 gap-x-6 gap-y-10 sm:grid-cols-4 lg:grid-cols-6">
              {g.items.map((i) => (
                <li class="text-center">
                  <div class="mx-auto flex h-12 items-center justify-center">
                    <img
                      src={i.logo}
                      alt=""
                      loading="lazy"
                      class="max-h-8 max-w-[80%] object-contain opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
                    />
                  </div>
                  <p class="mt-3 text-[13px] leading-tight">{i.name}</p>
                  <p class="mt-0.5 text-[11px] tabular-nums text-paper/40">{when(i)}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
